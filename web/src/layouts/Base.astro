---
import '../styles/global.css';
import BoxNav from '../components/BoxNav.astro';
interface Props { title?: string }
const { title = 'RAS — Reserve A Seat' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <main><slot /></main>
    <BoxNav />
    <footer class="wrap foot">Project RAS · Nigeria 2027 · Every seat is somebody's. Make it yours.</footer>
  </body>
</html>
<style>
  main { padding-top: 1rem; }
  .foot { padding: 2rem 16px 12rem; font-size: .85rem; opacity: .7; } /* room for the fixed nav */
</style>
